{"root":{"data":{"id":"dl5qy4qk3mw0","created":1788445300526,"text":"马克思主义基本原理","priority":null,"expandState":"expand"},"children":[{"data":{"id":"dl5r06irs8o0","created":1788445461137,"text":"马克思主义哲学  -哲学基础","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dl5r1twj7z40","created":1788445590399,"text":"导论"},"children":[{"data":{"id":"dl5r1yp2cgo0","created":1788445600831,"text":"马克思主义的创立与发展","expandState":"collapse"},"children":[{"data":{"id":"dl5rtjpq6rs0","created":1788447762416,"text":"科学内涵"},"children":[]},{"data":{"id":"dl5r262qg4w0","created":1788445616896,"text":"创立"},"children":[{"data":{"id":"dl5r2k6i8m80","created":1788445647599,"text":"社会根源","note":"资本主义生产方式一方面带来了社会化大生产的极大发展，另一方面也造成了深重的社会灾难。\n第一：社会两极分化，工人极端困苦；\n第二，周期性经济危机频繁发生"},"children":[]},{"data":{"id":"dl5r2q3b2ao0","created":1788445660466,"text":"阶级基础","note":"无产阶级反对资产阶级的压迫和剥削，需要科学理论指导\n三大工人运动（法国里昂工人两次起义，英国宪章运动，德国西里西亚纺织工人起义）标志着无产阶级作为独立的政治力量登上历史舞台。\n\n"},"children":[]},{"data":{"id":"dl5r2ryuxwo0","created":1788445664550,"text":"思想渊源","note":"**直接理论来源**：\n1. 德国古典哲学、\n2. 英国古典政治经济学、\n3. 英法空想社会主义\n\n**三大自然科学前提**：\n1. 细胞学说、\n2. 能量转化与守恒定律、\n3. 进化论\n"},"children":[]}]},{"data":{"id":"dl5r2hsgh5c0","created":1788445642395,"text":"创立过程","expandState":"expand"},"children":[{"data":{"id":"dl5r577djt40","created":1788445854445,"text":"《德法年鉴》","note":"：思想前提，\n唯心主义转向唯物主义\n革命民主主义转向共产主义"},"children":[]},{"data":{"id":"dl5r5s1h4g00","created":1788445899801,"text":"《神圣家族》","note":"：第一部合著著作"},"children":[]},{"data":{"id":"dl5r655t4o00","created":1788445928361,"text":"《德意志意识形态》","note":"：首次系统阐述唯物史观，区别与费尔巴哈的唯心史观\n"},"children":[]},{"data":{"id":"dl5r6qtgl4o0","created":1788445975504,"text":"《共产党宣言》","note":"：第一部无产阶级政党（共产主义者同盟）党纲，马克思主义公开问世"},"children":[]},{"data":{"id":"dl5r80zxmv40","created":1788446076027,"text":"《资本论》","note":"：剩余价值学说\n"},"children":[]},{"data":{"id":"dl5r8rj4ey80","created":1788446133784,"text":"《法兰西内战》","note":"：巴黎公社的历史经验，丰富科学社会主义学说\n"},"children":[]},{"data":{"id":"dl5ry93grog0","created":1788448131123,"text":"《哥达纲领批判》","note":"丰富科学社会主义学说"},"children":[]},{"data":{"id":"dl5r8bdtz2o0","created":1788446098635,"text":"《反杜林论》","note":"：系统阐述马克思主义三个基本组成部分，马克思主义的百科全书"},"children":[]}]},{"data":{"id":"dl5rzfg03w80","created":1788448223306,"text":"发展"},"children":[{"data":{"id":"dl5rzgnbz080","created":1788448225926,"text":"列宁","note":"政治经济发展不平衡，\n：一国胜利论\n马、恩：多国胜利论\n\n俄国十月革命：社会主义从理想变为现实\n"},"children":[]}]},{"data":{"id":"dl5rc3lpvao0","created":1788446395155,"text":"基本特征 4点"},"children":[{"data":{"id":"dl5rcrjaog00","created":1788446447251,"text":"科学性"},"children":[]},{"data":{"id":"dl5rcvowryo0","created":1788446456298,"text":"革命性"},"children":[{"data":{"id":"dl5rcy6axxk0","created":1788446461703,"text":"人民性：本质属性，人民至上"},"children":[]},{"data":{"id":"dl5rd1zm16g0","created":1788446470005,"text":"实践性","note":"：区别其他理论的根本特征；首要和基本的观点"},"children":[]},{"data":{"id":"dl5rd4547pk0","created":1788446474692,"text":"发展性：与时俱进的理论品质"},"children":[]}]}]},{"data":{"id":"dl5r4k65xuo0","created":1788445804306,"text":"当代价值 3点","expandState":"collapse"},"children":[{"data":{"id":"dl5r95o72940","created":1788446164566,"text":"观察当代世界变化的认识工具"},"children":[]},{"data":{"id":"dl5r9x4wa540","created":1788446224349,"text":"指引当代中国发展的行动指南"},"children":[]},{"data":{"id":"dl5r9fflmc00","created":1788446185814,"text":"引领人类社会进步的科学真理"},"children":[]}]}]}]},{"data":{"id":"dl5r1xkd2k80","created":1788445598370,"text":"世界的物质性及发展规律","expandState":"expand"},"children":[{"data":{"id":"dl5s1h15rw80","created":1788448383491,"text":"哲学基本问题","expandState":"expand"},"children":[{"data":{"id":"dl5s20f58080","created":1788448425695,"text":"存在和思维的关系问题（物质和意识）"},"children":[]}]},{"data":{"id":"dl5s2su5qdc0","created":1788448487553,"text":"哲学基本派别","expandState":"collapse"},"children":[{"data":{"id":"dl5s2vq1w9k0","created":1788448493835,"text":"第一性问题（本原）"},"children":[{"data":{"id":"dl5s37mgtlc0","created":1788448519740,"text":"唯物主义","note":"均为可知论"},"children":[]},{"data":{"id":"dl5s39993lc0","created":1788448523294,"text":"唯心主义","note":"分为可知论和不可知论"},"children":[{"data":{"id":"dl5s6zp2wso0","created":1788448815940,"text":"客观唯心主义","note":"脱离个人的精神：理念、理、绝对观念\n"},"children":[]},{"data":{"id":"dl5s6vdsbfs0","created":1788448806550,"text":"主观唯心主义","note":"个人的感觉观念：心、观念、感觉"},"children":[]}]}]},{"data":{"id":"dl5s3jiaqsg0","created":1788448545609,"text":"同一性问题（可知）"},"children":[{"data":{"id":"dl5s3stkvt40","created":1788448565882,"text":"可知论","note":"存在和思维具有同一性\n"},"children":[]},{"data":{"id":"dl5s3vwflzc0","created":1788448572585,"text":"不可知论"},"children":[]}]},{"data":{"id":"dl5s42qhujk0","created":1788448587463,"text":"世界怎样存在"},"children":[{"data":{"id":"dl5s4a3d1u00","created":1788448603479,"text":"辩证法","note":"联系、发展、全面；\n事物的发展根本原因在于事物的内部矛盾\n\t"},"children":[]},{"data":{"id":"dl5s4c0yvxc0","created":1788448607688,"text":"形而上学","note":"孤立、静止、片面\n否认事物内部矛盾的存在和作用"},"children":[]}]},{"data":{"id":"dl5s5uj1vl40","created":1788448726327,"text":"社会历史观"},"children":[{"data":{"id":"dl5s61589140","created":1788448740729,"text":"历史唯物主义（唯物史观）","note":"社会存在决定社会意识\n"},"children":[]},{"data":{"id":"dl5s65qix880","created":1788448750724,"text":"历史唯心主义（唯心史观）"},"children":[]}]}]},{"data":{"id":"dl5s1ozdspk0","created":1788448400797,"text":"唯物论","expandState":"expand"},"children":[{"data":{"id":"dl5s9gmx0tc0","created":1788449009543,"text":"物质范畴及其理论意义","expandState":"collapse"},"children":[{"data":{"id":"dl5s9sf7xr40","created":1788449035199,"text":"物质范畴 （物质观）"},"children":[{"data":{"id":"dl5s9xl3nxc0","created":1788449046438,"text":"古代朴素唯物主义"},"children":[]},{"data":{"id":"dl5sa1oqqeo0","created":1788449055366,"text":"近代形而上学唯物主义（机械唯物主义）"},"children":[]},{"data":{"id":"dl5sabzes3s0","created":1788449077778,"text":"现代辩证唯物主义","note":"客观实在\n"},"children":[{"data":{"id":"dl5sbdocwso0","created":1788449159828,"text":"恩格斯定义","note":"共性与个性"},"children":[]},{"data":{"id":"dl5sbl315d40","created":1788449175953,"text":"列宁定义","note":"物质是不依赖于人的意识而存在，并能为人的意识所反映的客观实在\n"},"children":[]}]}]},{"data":{"id":"dl5scksuyqo0","created":1788449253702,"text":"理论意义 4点","note":"1. 坚持了唯物主义一元论\n2. 坚持了能动的反映论和可知论\n3. 体现了唯物论和辩证法的统一\n4. 体现了唯物主义自然观与历史观的统一"},"children":[]}]},{"data":{"id":"dl5sfr6v9rc0","created":1788449502702,"text":"物质与运动、运动与静止（运动观）","expandState":"collapse"},"children":[{"data":{"id":"dl5sg1izu880","created":1788449525203,"text":"物质与运动"},"children":[{"data":{"id":"dl5sgevfyqg0","created":1788449554254,"text":"物质的根本属性是运动"},"children":[]},{"data":{"id":"dl5sgq6pm4w0","created":1788449578880,"text":"物质和运动不可分割"},"children":[]}]},{"data":{"id":"dl5sgbmcbns0","created":1788449547174,"text":"运动与静止"},"children":[{"data":{"id":"dl5sh2gx8940","created":1788449605619,"text":"绝对运动","note":"无条件\n"},"children":[]},{"data":{"id":"dl5si4oe0m00","created":1788449688788,"text":"相对静止","note":"相对静止、有条件\n是事物存在和发展的必要条件，\n是人们认识和利用事物的前提\n是过去运动的结果和未来运动的出发点，\n是理解和衡量运动的尺度"},"children":[]},{"data":{"id":"dl5shgzd6iw0","created":1788449637209,"text":"绝对运动和相对静止的辩证统一","note":"相互依赖、相互渗透、相互包含\n"},"children":[]}]},{"data":{"id":"dl5slhr45540","created":1788449952343,"text":"运动与时间空间"},"children":[{"data":{"id":"dl5slllhzyg0","created":1788449960711,"text":"时间、空间","note":"时间 ：一维性、不可逆\n\n空间 ：三维性\n\n时空 ： 客观性\n\n时间空间是运动着的物质的基本存在形式，时空与运动不可分割\n\n时空具有\n有限性：对具体物质\n无限性：对整个物质世界"},"children":[]}]}]},{"data":{"id":"dl5spq6qkpk0","created":1788450284159,"text":"物质世界的二重化","expandState":"collapse"},"children":[{"data":{"id":"dl5spz4dlbs0","created":1788450303607,"text":"自然界与人类社会"},"children":[]},{"data":{"id":"dl5sq4mo1c80","created":1788450315597,"text":"客观世界与主观世界"},"children":[]},{"data":{"id":"dl5sqhcwxgg0","created":1788450343306,"text":"人的实践活动","note":"自然界与人类社会、客观世界与主观世界相分化和统一的关键\n"},"children":[]}]},{"data":{"id":"dl5srmmn65s0","created":1788450433142,"text":"物质与意识的辩证关系","expandState":"collapse"},"children":[{"data":{"id":"dl5srvszedk0","created":1788450453116,"text":"物质决定意识","expandState":"expand"},"children":[{"data":{"id":"dlaseisik9s0","created":1788957205839,"text":" 意识起源","note":"意识是自然界长期发展的产物:\n- 反应特性 -) 刺激感应性 -) 感觉和心理 -) 人类意识\n\n\n意识是社会历史长期发展的产物：\n- 社会实践（劳动）起决定性作用：\n提供客观需要和可能；形成语言（是思维的物质外壳和意识的现实形式）"},"children":[]},{"data":{"id":"dlask3a0qgo0","created":1788957642254,"text":" 意识本质：","note":"意识是人脑的机能和属性，是客观世界的主观映像。是客观内容和主观形式的统一"},"children":[]}]},{"data":{"id":"dl5srxnztyw0","created":1788450457168,"text":"意识对物质具有反作用（能动作用）","note":"人特有的积极认识世界个改造世界的能力和活动\n"},"children":[{"data":{"id":"dlaso4jpesw0","created":1788957958473,"text":"目的性和计划性"},"children":[]},{"data":{"id":"dlasomhsgy80","created":1788957997539,"text":"创造性"},"children":[]},{"data":{"id":"dlasotuf7xs0","created":1788958013541,"text":"指导实践改造客观世界的作用"},"children":[]},{"data":{"id":"dlasobpyd8g0","created":1788957974088,"text":"调节人的行为和生理活动的作用"},"children":[]}]},{"data":{"id":"dlasq4y61wg0","created":1788958116076,"text":"主观能动性和客观规律性的辩证统一"},"children":[{"data":{"id":"dlasqelevso0","created":1788958137072,"text":"主观能动性和客观规律性的关系","note":"- 尊重客观规律是正确发挥主观能动性的前提\n- 只用充分发挥主观能动性，才能正确认识和利用客观规律\n\n\n","expandState":"expand"},"children":[{"data":{"id":"dlasuo5bsk00","created":1788958471324,"text":"正确发挥主观能动性的前提和条件","note":"- 从实际出发是~前提\n- 实践是~根本途径\n- 依赖于一定的物质条件和物质手段"},"children":[]}]},{"data":{"id":"dlastxjrtxs0","created":1788958413425,"text":"实践","note":"实践是客观规律性和主观能动性统一的基础\n\n"},"children":[]}]},{"data":{"id":"dlaswbrtusg0","created":1788958601115,"text":"意识和人工智能","expandState":"expand"},"children":[{"data":{"id":"dlaswecfwsw0","created":1788958606715,"text":"与人类智能的关系","note":"是人的意识能动性的一种特殊表现，是人的本质力量的对象化、现实化\n人类意识活动部分地从人脑中分离出来，物化为人的机器的物理运动，从而延伸意识器官功能。\t"},"children":[]},{"data":{"id":"dlasylxpuag0","created":1788958779967,"text":"人工智能无法取代人","note":"- 人类意识是知情意的统一体\n- 社会性是人的意识所固有的本质属性\n- 人类自然语言是思维的物质外壳和意识的现实形式\n- 人脑中有许多东西无法被化约为数字信号\n","layout_right_offset":{"x":-2,"y":9}},"children":[]}]}]},{"data":{"id":"dlat0w7krhc0","created":1788958959059,"text":"世界的物质统一性原理","expandState":"collapse"},"children":[{"data":{"id":"dlat0zoumw00","created":1788958966634,"text":"原理","note":"- 自然界是物质的\n- 人类社会是物质的\n- 意识统一于物质\n"},"children":[]},{"data":{"id":"dlat2ou6t880","created":1788959099741,"text":"世界的物质统一性是多样性的统一"},"children":[]},{"data":{"id":"dlat3j5bq740","created":1788959165718,"text":"意义","note":"- 是辩证唯物主义的最基本、最核心的观点，是马克思主义的基石"},"children":[]},{"data":{"id":"dlat4j308fc0","created":1788959243942,"text":"方法论","note":"一切从实际出发，是坚持和发展中国特色社会主义伟大实践中想问题和办事情的根本立足点\n"},"children":[]}]}]},{"data":{"id":"dl5s1qdkrmo0","created":1788448403832,"text":"辩证法","layout_right_offset":{"x":-6,"y":0}},"children":[{"data":{"id":"dl5ssqj9dug0","created":1788450520009,"text":"事物的普遍联系和变化发展"},"children":[{"data":{"id":"dl5ssxtiwyo0","created":1788450535867,"text":"普遍联系"},"children":[{"data":{"id":"dlat8to1nm00","created":1788959580438,"text":"联系的特点"},"children":[{"data":{"id":"dlat8zwxxb40","created":1788959594037,"text":"客观性","note":"联系是事物固有的，不以人的意志为转移"},"children":[]},{"data":{"id":"dlat93573600","created":1788959601066,"text":"普遍性","note":"- 任何事物都具有内在结构性\n- 任何事物同其他事物处于一定的联系中\n- 整个世界是相互联系的统一整体"},"children":[]},{"data":{"id":"dlat95b01xk0","created":1788959605771,"text":"多样性"},"children":[]},{"data":{"id":"dlat970up9s0","created":1788959609511,"text":"条件性","note":"- 条件具有支持或制约作用\n- 条件可以改变\n- 改变和创造条件不是任意的，必须尊重客观规律"},"children":[]}]},{"data":{"id":"dlatcun7qg80","created":1788959896021,"text":"自在事物的联系、\n人为事物的联系","note":"自在事物的联系：\n- 人产生之前就存在或仍处在人的活动之外\n\n人为事物的联系\n- 人类实践活动形成的，具有人化的特点"},"children":[]}]},{"data":{"id":"dl5st07ufgw0","created":1788450541086,"text":"变化发展"},"children":[{"data":{"id":"dlatibs5ws00","created":1788960325147,"text":"变化","note":"- 变化泛指事物发生的一切改变，\n事物的具体运动过程、状态\n\n运动：事物的根本属性\n\n","layout_right_offset":{"x":10.833332902855318,"y":6.666666401757141}},"children":[]},{"data":{"id":"dlatfrzbdq00","created":1788960125315,"text":"发展实质","note":"- 发展的本质是新事物的产生和旧事物的灭亡\n"},"children":[{"data":{"id":"dlati00vc0w0","created":1788960299552,"text":"新事物是不可战胜的","note":"- 适应已经变化了的环境和条件\n- 本质上优于旧事物，扬弃：否定消极腐朽、保留合理适应新条件的因素、添加了新内容"},"children":[]},{"data":{"id":"dlatmdb4mwo0","created":1788960641927,"text":"区分新旧事物的根本标志","note":"同历史发展的必然趋势相符\n"},"children":[]}]}]}]},{"data":{"id":"dl5st6xxq3c0","created":1788450555725,"text":"对立统一规律","note":"是事物发展的根本规律","layout_right_offset":{"x":-3.7499999441206455,"y":-7.499999888241291}},"children":[{"data":{"id":"dlato6brohs0","created":1788960783457,"text":"地位","note":"是唯物辩证法的实质和核心\n- 揭示了事物普遍联系的根本内容和变化发展的根本动力\n- 理解量变质变规律和否定之否定规律中心线索\n- 提供认识世界和改造世界的根本方法：矛盾分析法（对立统一规律）"},"children":[]},{"data":{"id":"dlatq58mqcg0","created":1788960937818,"text":"矛盾"},"children":[{"data":{"id":"dlatqarddfc0","created":1788960949835,"text":"同一性和斗争性的辩证关系","note":"斗争性寓于同一性中，同一性通过斗争性表现。斗争性"},"children":[]},{"data":{"id":"dlatqcjk6kw0","created":1788960953717,"text":"同一性","note":"对立面相互依存、相互贯通的性质和趋势\n"},"children":[]},{"data":{"id":"dlatqe8zbsg0","created":1788960957431,"text":"斗争性","note":"对立面相互排斥、相互分离的性质和趋势\n\n"},"children":[]}]}]},{"data":{"id":"dl5stijcumg0","created":1788450580964,"text":"量变质变规律"},"children":[{"data":{"id":"dl5sv3sdrtk0","created":1788450705587,"text":"质、量、度","note":"质：区别于其他事物的内在规定性\n量：数量关系表示的规定性\n度：保持事物质的稳定性的数量界限\n；掌握适度原则\n\n关系：\n质、量是统一的；\n质和事物的存在直接同一\n量和事物的存在不直接同一\n区分质是认识量的前提，考察量是认识质的sh"},"children":[]},{"data":{"id":"dl5svde6fsg0","created":1788450726496,"text":"量变质变辩证关系"},"children":[]}]},{"data":{"id":"dl5stq40m9c0","created":1788450597451,"text":"否定之否定规律"},"children":[]},{"data":{"id":"dl5stwkdab40","created":1788450611500,"text":"五大范畴"},"children":[]}]}]}]},{"data":{"id":"dl5r146d79c0","created":1788445534397,"text":"马克思主义政治经济学 -主要内容"},"children":[]},{"data":{"id":"dl5r1dumnkg0","created":1788445555456,"text":"科学社会主义 -核心结论"},"children":[]}]},"template":"right","theme":"fresh-red-compat","version":"1.4.43"}