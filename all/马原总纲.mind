{"root":{"data":{"id":"dl5qy4qk3mw0","created":1788445300526,"text":"马克思主义基本原理","priority":null,"expandState":"expand"},"children":[{"data":{"id":"dl5r06irs8o0","created":1788445461137,"text":"马克思主义哲学  -哲学基础","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dl5r1twj7z40","created":1788445590399,"text":"导论"},"children":[{"data":{"id":"dl5r1yp2cgo0","created":1788445600831,"text":"马克思主义的创立与发展","expandState":"collapse"},"children":[{"data":{"id":"dl5rtjpq6rs0","created":1788447762416,"text":"科学内涵"},"children":[]},{"data":{"id":"dl5r262qg4w0","created":1788445616896,"text":"创立"},"children":[{"data":{"id":"dl5r2k6i8m80","created":1788445647599,"text":"社会根源","note":"资本主义生产方式一方面带来了社会化大生产的极大发展，另一方面也造成了深重的社会灾难。\n第一：社会两极分化，工人极端困苦；\n第二，周期性经济危机频繁发生"},"children":[]},{"data":{"id":"dl5r2q3b2ao0","created":1788445660466,"text":"阶级基础","note":"无产阶级反对资产阶级的压迫和剥削，需要科学理论指导\n三大工人运动（法国里昂工人两次起义，英国宪章运动，德国西里西亚纺织工人起义）标志着无产阶级作为独立的政治力量登上历史舞台。\n\n"},"children":[]},{"data":{"id":"dl5r2ryuxwo0","created":1788445664550,"text":"思想渊源","note":"**直接理论来源**：\n1. 德国古典哲学、\n2. 英国古典政治经济学、\n3. 英法空想社会主义\n\n**三大自然科学前提**：\n1. 细胞学说、\n2. 能量转化与守恒定律、\n3. 进化论\n"},"children":[]}]},{"data":{"id":"dl5r2hsgh5c0","created":1788445642395,"text":"创立过程","expandState":"expand"},"children":[{"data":{"id":"dl5r577djt40","created":1788445854445,"text":"《德法年鉴》","note":"：思想前提，\n唯心主义转向唯物主义\n革命民主主义转向共产主义"},"children":[]},{"data":{"id":"dl5r5s1h4g00","created":1788445899801,"text":"《神圣家族》","note":"：第一部合著著作"},"children":[]},{"data":{"id":"dl5r655t4o00","created":1788445928361,"text":"《德意志意识形态》","note":"：首次系统阐述唯物史观，区别与费尔巴哈的唯心史观\n"},"children":[]},{"data":{"id":"dl5r6qtgl4o0","created":1788445975504,"text":"《共产党宣言》","note":"：第一部无产阶级政党（共产主义者同盟）党纲，马克思主义公开问世"},"children":[]},{"data":{"id":"dl5r80zxmv40","created":1788446076027,"text":"《资本论》","note":"：剩余价值学说\n"},"children":[]},{"data":{"id":"dl5r8rj4ey80","created":1788446133784,"text":"《法兰西内战》","note":"：巴黎公社的历史经验，丰富科学社会主义学说\n"},"children":[]},{"data":{"id":"dl5ry93grog0","created":1788448131123,"text":"《哥达纲领批判》","note":"丰富科学社会主义学说"},"children":[]},{"data":{"id":"dl5r8bdtz2o0","created":1788446098635,"text":"《反杜林论》","note":"：系统阐述马克思主义三个基本组成部分，马克思主义的百科全书"},"children":[]}]},{"data":{"id":"dl5rzfg03w80","created":1788448223306,"text":"发展"},"children":[{"data":{"id":"dl5rzgnbz080","created":1788448225926,"text":"列宁","note":"政治经济发展不平衡，\n：一国胜利论\n马、恩：多国胜利论\n\n俄国十月革命：社会主义从理想变为现实\n"},"children":[]}]},{"data":{"id":"dl5rc3lpvao0","created":1788446395155,"text":"基本特征 4点"},"children":[{"data":{"id":"dl5rcrjaog00","created":1788446447251,"text":"科学性"},"children":[]},{"data":{"id":"dl5rcvowryo0","created":1788446456298,"text":"革命性"},"children":[{"data":{"id":"dl5rcy6axxk0","created":1788446461703,"text":"人民性：本质属性，人民至上"},"children":[]},{"data":{"id":"dl5rd1zm16g0","created":1788446470005,"text":"实践性","note":"：区别其他理论的根本特征；首要和基本的观点"},"children":[]},{"data":{"id":"dl5rd4547pk0","created":1788446474692,"text":"发展性：与时俱进的理论品质"},"children":[]}]}]},{"data":{"id":"dl5r4k65xuo0","created":1788445804306,"text":"当代价值 3点","expandState":"collapse"},"children":[{"data":{"id":"dl5r95o72940","created":1788446164566,"text":"观察当代世界变化的认识工具"},"children":[]},{"data":{"id":"dl5r9x4wa540","created":1788446224349,"text":"指引当代中国发展的行动指南"},"children":[]},{"data":{"id":"dl5r9fflmc00","created":1788446185814,"text":"引领人类社会进步的科学真理"},"children":[]}]}]}]},{"data":{"id":"dl5r1xkd2k80","created":1788445598370,"text":"世界的物质性及发展规律"},"children":[{"data":{"id":"dl5s1h15rw80","created":1788448383491,"text":"哲学基本问题","expandState":"expand"},"children":[{"data":{"id":"dl5s20f58080","created":1788448425695,"text":"存在和思维的关系问题（物质和意识）"},"children":[]}]},{"data":{"id":"dl5s2su5qdc0","created":1788448487553,"text":"哲学基本派别","expandState":"collapse"},"children":[{"data":{"id":"dl5s2vq1w9k0","created":1788448493835,"text":"第一性问题（本原）"},"children":[{"data":{"id":"dl5s37mgtlc0","created":1788448519740,"text":"唯物主义","note":"均为可知论"},"children":[]},{"data":{"id":"dl5s39993lc0","created":1788448523294,"text":"唯心主义","note":"分为可知论和不可知论"},"children":[{"data":{"id":"dl5s6zp2wso0","created":1788448815940,"text":"客观唯心主义","note":"脱离个人的精神：理念、理、绝对观念\n"},"children":[]},{"data":{"id":"dl5s6vdsbfs0","created":1788448806550,"text":"主观唯心主义","note":"个人的感觉观念：心、观念、感觉"},"children":[]}]}]},{"data":{"id":"dl5s3jiaqsg0","created":1788448545609,"text":"同一性问题（可知）"},"children":[{"data":{"id":"dl5s3stkvt40","created":1788448565882,"text":"可知论","note":"存在和思维具有同一性\n"},"children":[]},{"data":{"id":"dl5s3vwflzc0","created":1788448572585,"text":"不可知论"},"children":[]}]},{"data":{"id":"dl5s42qhujk0","created":1788448587463,"text":"世界怎样存在"},"children":[{"data":{"id":"dl5s4a3d1u00","created":1788448603479,"text":"辩证法","note":"联系、发展、全面；\n事物的发展根本原因在于事物的内部矛盾\n\t"},"children":[]},{"data":{"id":"dl5s4c0yvxc0","created":1788448607688,"text":"形而上学","note":"孤立、静止、片面\n否认事物内部矛盾的存在和作用"},"children":[]}]},{"data":{"id":"dl5s5uj1vl40","created":1788448726327,"text":"社会历史观"},"children":[{"data":{"id":"dl5s61589140","created":1788448740729,"text":"历史唯物主义（唯物史观）","note":"社会存在决定社会意识\n"},"children":[]},{"data":{"id":"dl5s65qix880","created":1788448750724,"text":"历史唯心主义（唯心史观）"},"children":[]}]}]},{"data":{"id":"dl5s9gmx0tc0","created":1788449009543,"text":"物质范畴及其理论意义"},"children":[{"data":{"id":"dl5s9sf7xr40","created":1788449035199,"text":"物质观"},"children":[{"data":{"id":"dl5s9xl3nxc0","created":1788449046438,"text":"古代朴素唯物主义"},"children":[]},{"data":{"id":"dl5sa1oqqeo0","created":1788449055366,"text":"近代形而上学唯物主义（机械唯物主义）"},"children":[]},{"data":{"id":"dl5sabzes3s0","created":1788449077778,"text":"现代辩证唯物主义","note":"客观实在\n"},"children":[{"data":{"id":"dl5sbdocwso0","created":1788449159828,"text":"恩格斯定义","note":"共性与个性"},"children":[]},{"data":{"id":"dl5sbl315d40","created":1788449175953,"text":"列宁定义","note":"物质是不依赖于人的意识而存在，并能为人的意识所反映的客观实在\n"},"children":[]}]}]}]},{"data":{"id":"dl5s1ozdspk0","created":1788448400797,"text":"唯物论"},"children":[]},{"data":{"id":"dl5s1qdkrmo0","created":1788448403832,"text":"辩证法"},"children":[]}]}]},{"data":{"id":"dl5r146d79c0","created":1788445534397,"text":"马克思主义政治经济学 -主要内容"},"children":[]},{"data":{"id":"dl5r1dumnkg0","created":1788445555456,"text":"科学社会主义 -核心结论"},"children":[]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}